{
	"defaultAgent": null,
	"keybindings": {
		"select": ["ctrl+shift+a", "alt+a"],
		"rotate": ["ctrl+shift+q", "alt+q"],
		"inspect": "f9"
	},
	"subagents": {
		"staleWarningMinutes": 5,
		"gracefulStopSeconds": 5
	},
	"mcpServers": {
		"filesystem": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-filesystem@latest", "."]
		}
	}
}
